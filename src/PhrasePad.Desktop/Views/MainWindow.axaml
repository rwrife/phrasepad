<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhrasePad.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="680"
        x:Class="PhrasePad.Desktop.Views.MainWindow"
        x:DataType="vm:SnippetEditorViewModel"
        Width="1080"
        Height="680"
        MinWidth="820"
        MinHeight="540"
        Title="PhrasePad">

    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0"
                Padding="20"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="PhrasePad" />
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,24"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="Local snippet library" />
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="GROUPS" />
                    <Border Padding="12,10"
                            CornerRadius="6"
                            Background="{DynamicResource SystemControlHighlightListLowBrush}">
                        <TextBlock Text="All snippets" />
                    </Border>
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="Group management and persistence arrive in the next increment." />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="32" MaxWidth="760" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="Snippet editor" />
                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="Edit a snippet and preview the resolved expansion instantly." />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Trigger" />
                        <TextBox PlaceholderText=";signature"
                                 Text="{Binding Trigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,8"
                              Content="Enabled"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Expansion" />
                    <TextBox MinHeight="190"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             PlaceholderText="Best regards,&#10;Your name&#10;{date:yyyy-MM-dd}"
                             Text="{Binding Expansion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="Try {date}, {time}, or {cursor}. Double braces render literally." />
                </StackPanel>

                <Border Padding="20"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Test expansion" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                <Run Text="Caret offset: " />
                                <Run Text="{Binding PreviewCaretOffset}" />
                            </TextBlock>
                        </Grid>
                        <Border MinHeight="100"
                                Padding="14"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <TextBlock FontFamily="Cascadia Mono, Menlo, monospace"
                                       TextWrapping="Wrap"
                                       Text="{Binding PreviewWithCaret}" />
                        </Border>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="The │ marker shows where typing resumes; it is not inserted into the expansion." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
